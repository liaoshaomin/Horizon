{
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "api_key_env": "GOOGLE_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "languages": ["zh"]
  },

  "sources": {
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "finance",
          "sort": "hot",
          "fetch_limit": 15,
          "min_score": 30
        },
        {
          "subreddit": "investing",
          "sort": "hot",
          "fetch_limit": 15,
          "min_score": 30
        },
        {
          "subreddit": "economics",
          "sort": "hot",
          "fetch_limit": 10,
          "min_score": 20
        },
        {
          "subreddit": "stocks",
          "sort": "hot",
          "fetch_limit": 15,
          "min_score": 50
        }
      ],
      "fetch_comments": 5
    },

    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 80
    },

    "rss": {
      "enabled": true,
      "feeds": [
        {
          "name": "Bloomberg Markets",
          "url": "https://feeds.bloomberg.com/markets/news.rss",
          "enabled": true
        },
        {
          "name": "Reuters Business",
          "url": "https://www.reutersagency.com/feed/?best-topics=business-finance&post_type=best",
          "enabled": true
        },
        {
          "name": "华尔街见闻",
          "url": "https://wallstreetcn.com/rss/news",
          "enabled": true
        },
        {
          "name": "36氪",
          "url": "https://36kr.com/feed",
          "enabled": true
        }
      ]
    },

    "github": {
      "enabled": false
    },

    "telegram": {
      "enabled": false
    }
  },

  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 2
  },

  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "platform": "generic",
    "layout": "markdown"
  }
}
